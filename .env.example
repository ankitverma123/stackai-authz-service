SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me
# Supabase signs user access tokens with ES256 (asymmetric); point this at the JWKS so
# the app can verify them. Omit to fall back to HS256 against SUPABASE_JWT_SECRET.
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
WORKFLOW_ACCESS_TOKEN_SECRET=replace-me
LOG_LEVEL=INFO
